APP_NAME="Khalid Traders ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.vercel.app

APP_LOCALE=ur
APP_FALLBACK_LOCALE=en

# Database Configuration (Connect to hosted MySQL / PostgreSQL on Vercel, or local MySQL/SQLite)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fashionking
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array

LOG_CHANNEL=stderr
LOG_LEVEL=error
